# 공공데이터포털 인증키 (Decoding 키) - scripts/fetch_public_data.py 에서만 사용
DATA_GO_KR_KEY=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 정책 요약 미리 만들기용 (scripts/generate_policy_summaries.py)
GEMINI_MODEL=gemini-3.5-flash
# 서버 실시간 응답용 (맞춤 팁)
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# 0 이면 Gemini를 호출하지 않고 대체 응답만 사용
GEMINI_ENABLED=1
